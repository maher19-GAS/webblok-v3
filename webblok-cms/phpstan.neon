includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 10
    paths:
        - app
        - database/factories
        - database/migrations
        - database/seeders
        - routes
    checkUninitializedProperties: true
    checkDynamicProperties: true
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true
    ignoreErrors:
        # Eloquent relations forward query-builder calls (orderBy, where, ...) at
        # runtime; phpstan-strict-rules misreports these as dynamic calls to the
        # generic Builder<...> static methods. This is an upstream Larastan/Eloquent
        # limitation, not a real defect.
        -
            identifier: staticMethod.dynamicCall
            message: '#Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder<#'
        # $request->validate() is a first-class Laravel instance method exposed via
        # a macro/trait; strict-rules flags the facade-style call. Safe to allow.
        -
            identifier: staticMethod.dynamicCall
            message: '#Dynamic call to static method Illuminate\\Http\\Request::validate\(\)#'
        # view() resolves Blade templates by name at runtime; the view-string
        # literal requirement is a static-analysis nicety, not a runtime contract.
        -
            identifier: argument.type
            message: '#Parameter \#1 \$view of function view expects view-string\|null, string given#'
